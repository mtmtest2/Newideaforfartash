# syntax=docker/dockerfile:1
# Fartash website with live CMS content: builds the Vite app (+ static fallback pages) and runs server/index.mjs.
# The original static image (Dockerfile + Caddy) stays available and keeps working with the built-in content.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG SITE_URL=https://mrmdev.xyz
ENV SITE_URL=${SITE_URL}
RUN npm run build && node scripts/precompress.mjs dist && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3000
COPY --from=build --chown=node:node /app/package.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/dist-server ./dist-server
COPY --from=build --chown=node:node /app/server ./server
COPY --from=build --chown=node:node /app/scripts/page.mjs ./scripts/page.mjs
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/index.mjs"]
