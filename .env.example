# Copy to .env and adjust.

# Public URL of the site (canonical/OG tags, robots.txt, sitemap.xml). Baked in at build time.
SITE_URL=https://mrmdev.xyz

# Mode A (docker-compose.yml): name of the Docker network your existing Caddy container is on.
#   find it with:  docker inspect <your-caddy-container> --format '{{json .NetworkSettings.Networks}}'
CADDY_NETWORK=caddy

# Mode B (docker-compose.standalone.yml): domain(s) this container serves with automatic HTTPS.
SITE_ADDRESS=mrmdev.xyz, www.mrmdev.xyz

# Tag for the built image (lets you keep the previous image for quick rollback).
IMAGE_TAG=performance-caddy
