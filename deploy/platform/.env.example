# Fartash platform (deploy/platform/docker-compose.yml). Never commit the filled-in .env.
# Generate secrets with:  openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME
PAYLOAD_SECRET=CHANGE_ME
CONTENT_API_SECRET=CHANGE_ME
# encrypts sign-in cookies (32+ chars); changing it signs everyone out
SESSION_SECRET=CHANGE_ME
# SMS provider for one-time sign-in codes; leave empty until a provider is wired (docs/AUTH.md)
SMS_PROVIDER=
# Public addresses
SITE_URL=https://mrmdev.xyz
CMS_PUBLIC_URL=https://cms.mrmdev.xyz
# Docker network of your existing Caddy reverse proxy
CADDY_NETWORK=caddy
# Seconds a rendered page stays cached (changes in the dashboard clear the cache immediately anyway)
CACHE_TTL=300
# Emergency: 1 forces offline courses OFF regardless of the dashboard switch
OFFLINE_COURSES_FORCE_OFF=0
IMAGE_TAG=platform
