# ---- Fartash CMS (Support Dashboard + content API) ----
# PostgreSQL. The CMS owns schema "cms" only (see docs/CMS-DATABASE.md).
DATABASE_URL=postgres://fartash:CHANGE_ME@postgres:5432/fartash
# Long random string (openssl rand -hex 32). Signs CMS admin sessions.
PAYLOAD_SECRET=CHANGE_ME_64_HEX
# Public URL of the CMS (used for CSRF/CORS allow-lists and links in emails)
CMS_PUBLIC_URL=https://cms.example.com
# Public website URL (preview links, sitemap, canonical URLs)
SITE_URL=https://mrmdev.xyz
# Shared secret the public site uses to ask for previews and that the CMS uses to call the site's revalidation hook
CONTENT_API_SECRET=CHANGE_ME_64_HEX
# Where the public site listens for cache revalidation (internal Docker URL)
SITE_REVALIDATE_URL=http://fartash-web:3000/__revalidate
# Uploaded public media directory (mounted volume)
MEDIA_DIR=/data/media
# Private files (course resources) — never served publicly
PRIVATE_FILES_DIR=/data/private
# Emergency override: set to 1 to force offline courses OFF regardless of the dashboard switch (can only disable, never enable)
OFFLINE_COURSES_FORCE_OFF=0
