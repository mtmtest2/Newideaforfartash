# Fartash static site — Apache / cPanel. Copied into dist/ by the build; upload dist/ as the web root.
# Caching policy: /assets/* hashed -> 1 year immutable; HTML -> always revalidate; other root files -> 1 day.

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|txt|xml)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    # onsuccess (default table): only 2xx responses get the 1-year header, never a 404
    Header onsuccess set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType video/mp4 .mp4
</IfModule>

# Prerendered routes (/teachers -> /teachers/index.html) and SPA fallback for unknown paths.
# DirectorySlash Off: serve /teachers directly instead of a 301 to /teachers/ (the rewrite below maps it).
DirectoryIndex index.html
DirectorySlash Off
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteRule ^ index.html [L]
</IfModule>
# Byte-range requests for the intro video are served by Apache's core for static files by default.
